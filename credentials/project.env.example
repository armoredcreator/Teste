# Copy this file to credentials/project.env
# Never commit credentials/project.env.

# Telegram API credentials (create your own at https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram sources to audit
SOURCE_1=-1003788989075
SOURCE_2=-1002698134896
SOURCE_3=-1002039708059

# Shopee Affiliate API (Vision V1)
# Obtain these from the Shopee Affiliate Open API credentials.
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_API_TIMEOUT=30
SHOPEE_API_MAX_RETRIES=3
SHOPEE_API_RETRY_BASE_SECONDS=2

# Historical Hub routing: one topic per source. If omitted, ARMORED_HUB_TOPIC_ID is used.
HUB_TOPIC_1=
HUB_TOPIC_2=
HUB_TOPIC_3=

# AI / Studio
ARMORED_IA_ENABLED=1
ARMORED_IA_CAPTION_ENABLED=1
ARMORED_IA_MODEL=gemini-3.1-flash-lite
ARMORED_IA_API_TIMEOUT=90
ARMORED_IA_MAX_CANDIDATES=10
ARMORED_IA_MAX_ATTEMPTS=5
ARMORED_IA_RETRY_DELAY=2
ARMORED_IA_AUDIENCE=público brasileiro de descoberta e lifestyle
GEMINI_API_KEY=

ARMORED_FFMPEG=ffmpeg
ARMORED_FFPROBE=ffprobe
ARMORED_RVC_ROOT=
ARMORED_STUDIO_MUSIC=
ARMORED_STUDIO_BANNER=
ARMORED_STUDIO_RVC_VOICE=melody

# Telegram Hub
ARMORED_CREATOR_BOT_TOKEN=
ARMORED_HUB_TOPIC_ID=
ARMORED_HUB_DRY_RUN=0
